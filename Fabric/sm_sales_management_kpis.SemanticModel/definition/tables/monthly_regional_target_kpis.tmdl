table monthly_regional_target_kpis
	lineageTag: 70c21a16-8c55-4cb1-afc8-262cb9dc175e
	sourceLineageTag: [sales_gold].[monthly_regional_target_kpis]

	measure 'Total Revenue' =
			
			SUM('monthly_regional_target_kpis'[Revenue])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b45c9efa-aba2-4a3e-ac08-eaccfbd4cdc5

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' =
			
			SUM('monthly_regional_target_kpis'[Profit])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: dde05da9-0ceb-46b4-953a-f0d6ced7c0e6

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sales Target (Actual Periods)' =
			
			CALCULATE(
			    SUM('monthly_regional_target_kpis'[SalesTarget]),
			    'monthly_regional_target_kpis'[ActualsAvailable] = TRUE()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 49c960cb-e34c-47d6-adb6-e7b7cc6ee83d

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Target Variance' =
			
			[Total Revenue] - [Sales Target (Actual Periods)]
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 89e2f390-0e07-48f1-9e9c-3d7927b74c5c

		changedProperty = Name

		changedProperty = FormatString

	measure 'Target Achievement %' =
			
			DIVIDE(
			    [Total Revenue],
			    [Sales Target (Actual Periods)]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 97b96133-a39a-49a0-969a-f61b311fc823

		changedProperty = Name

		changedProperty = FormatString

	measure 'Profit Margin %' =
			
			DIVIDE(
			    [Total Profit],
			    [Total Revenue]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 971ab19a-0baf-420c-aacf-dbbddd36c43c

		changedProperty = Name

		changedProperty = FormatString

	measure 'Total Orders' =
			
			SUM('monthly_regional_target_kpis'[Orders])
		formatString: 0
		lineageTag: d85e327c-1a3b-4e8e-bbcf-00a4f6d969c8

		changedProperty = Name

	measure 'Units Sold' =
			
			SUM('monthly_regional_target_kpis'[UnitsSold])
		formatString: 0
		lineageTag: 838850e2-df9c-4d3d-b86c-802034182914

		changedProperty = Name

