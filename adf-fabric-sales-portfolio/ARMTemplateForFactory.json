				"schema": [
					{
						"name": "OrderID",
						"type": "String"
					},
					{
						"name": "OrderLineID",
						"type": "String"
					},
					{
						"name": "OrderDate",
						"type": "String"
					},
					{
						"name": "LoadTimestamp",
						"type": "String"
					},
					{
						"name": "CustomerID",
						"type": "String"
					},
					{
						"name": "ProductID",
						"type": "String"
					},
					{
						"name": "Region",
						"type": "String"
					},
					{
						"name": "SalesChannel",
						"type": "String"
					},
					{
						"name": "PaymentMethod",
						"type": "String"
					},
					{
						"name": "Quantity",
						"type": "String"
					},
					{
						"name": "UnitPrice",
						"type": "String"
					},
					{
						"name": "DiscountPct",
						"type": "String"
					},
					{
						"name": "SalesAmount",
						"type": "String"
					},
					{
						"name": "CostAmount",
						"type": "String"
					},
					{
						"name": "ProfitAmount",
						"type": "String"
					},
					{
						"name": "OrderStatus",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_sales')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_sales')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Managed identity connection from Azure Data Factory to ADLS Gen2 sales landing zone.",
