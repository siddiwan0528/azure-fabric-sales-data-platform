			"name": "[concat(parameters('factoryName'), '/ds_products_excel')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_sales",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Excel",
				"typeProperties": {
					"sheetName": "Products",
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "sales_data.xlsx",
						"folderPath": "sales",
						"fileSystem": "landing"
					},
					"firstRowAsHeader": true
				},
				"schema": [
					{
						"name": "ProductID",
						"type": "String"
