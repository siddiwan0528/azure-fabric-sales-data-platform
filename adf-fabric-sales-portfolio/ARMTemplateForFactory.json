				"typeProperties": {
					"sheetName": "Customers",
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "sales_data.xlsx",
						"folderPath": "sales",
						"fileSystem": "landing"
					},
					"firstRowAsHeader": true
				},
				"schema": [
					{
						"name": "CustomerID",
						"type": "String"
					},
					{
						"name": "CustomerName",
						"type": "String"
					},
					{
						"name": "Segment",
						"type": "String"
					},
					{
						"name": "Region",
						"type": "String"
					},
					{
						"name": "City",
