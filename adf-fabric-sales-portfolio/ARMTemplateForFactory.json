{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-fabric-sales-portfolio"
		},
		"ls_adls_sales_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfabricportfolio61.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_sales')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "cpy_sales_excel_to_fabric",
						"description": "Ingest synthetic sales Excel data from ADLS Gen2 landing zone into the Fabric Bronze Lakehouse.",
						"type": "Copy",
						"dependsOn": [],
