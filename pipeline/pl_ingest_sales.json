									"physicalType": "String"
								},
								"sink": {
									"name": "ProfitAmount",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "OrderStatus",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderStatus",
									"physicalType": "string"
								}
							}
