{
	"name": "pl_ingest_sales",
	"properties": {
		"activities": [
			{
				"name": "cpy_sales_excel_to_fabric",
				"description": "Ingest synthetic sales Excel data from ADLS Gen2 landing zone into the Fabric Bronze Lakehouse.",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "LakehouseTableSink",
						"tableActionOption": "Append",
						"partitionOption": "None"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "OrderID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderID",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "OrderLineID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderLineID",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "OrderDate",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderDate",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "LoadTimestamp",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "LoadTimestamp",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "CustomerID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "CustomerID",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "ProductID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "ProductID",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "Region",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Region",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "SalesChannel",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "SalesChannel",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "PaymentMethod",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "PaymentMethod",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "Quantity",
