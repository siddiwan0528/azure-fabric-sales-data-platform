									"physicalType": "String"
								},
								"sink": {
									"name": "DiscountPct",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "SalesAmount",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "SalesAmount",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "CostAmount",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "CostAmount",
									"physicalType": "string"
								}
							},
							{
								"source": {
									"name": "ProfitAmount",
